# Optional - without it, triage() writes its reasoning from a
# deterministic template instead of asking Claude to narrate it.
# The verdict itself never depends on this key; see soc/triage.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Required to actually resolve ip/domain/hash evidence for real (see
# mcp-threat-intel's own .env.example for where to get free keys).
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional - NVD works without a key, just rate-limited harder.
NVD_API_KEY=

# Optional - where the audit-trail SQLite database lives. Defaults to
# ./soc_analyst.db. Only used by soc/api.py (the running service) - the
# eval harness and offline tests never touch this.
SOC_STORE_DB=

# Optional shared-secret auth for the API service (see soc/security.py).
# Leave unset for local dev - every route stays open. Set it the moment
# this deploys anywhere reachable beyond your own machine.
SOC_API_KEY=

# Optional per-source auth (see soc/security.py::identify_source), on
# top of SOC_API_KEY. A JSON object mapping each upstream integration's
# own secret to a name, e.g. {"<key-a>":"edr-vendor","<key-b>":"siem-vendor"}.
# Leave unset to keep the documented alert_id-only correlation trust
# model; configure it (and have each integration send its own key as
# X-Source-Key) to make cross-alert correlation trust only a genuinely
# different, authenticated reporter - not just a different alert_id.
SOC_SOURCE_KEYS=
