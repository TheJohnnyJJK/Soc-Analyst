# Optional - without it, triage() writes its reasoning from a
# deterministic template instead of asking Claude to narrate it.
# The verdict itself never depends on this key; see soc/triage.py.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Required to actually resolve ip/domain/hash evidence for real (see
# mcp-threat-intel's own .env.example for where to get free keys).
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional - NVD works without a key, just rate-limited harder.
NVD_API_KEY=
